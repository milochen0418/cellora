# Every setting here is OPTIONAL. With none of them set, Cellora keeps its notebooks and files in
# its data folder and uses Ollama on this machine for AI, when it has a model.

# AI: with an Anthropic API key, the AI is Claude (each AI request sends the relevant part of the
# notebook to Anthropic). Without one, Ollama: run `ollama pull qwen2.5-coder:7b` first.
# ANTHROPIC_API_KEY=
# CELLORA_CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# CELLORA_AI_PROVIDER=auto        # auto | claude | ollama | off

# Running a notebook runs Python on this machine. With a passcode, running code asks for it once
# per tab; reading and editing stay open.
# CELLORA_RUN_PASSCODE=

# Where notebooks (when not in a re-ddns collection), the workspace and the kernels' files live.
# Default: ~/Library/Application Support/cellora (macOS), ~/.local/share/cellora (Linux).
# CELLORA_HOME=
# CELLORA_FILES_DIR=

# Kernels: how many may run at once, and after how many idle minutes one stops.
# CELLORA_MAX_KERNELS=6
# CELLORA_KERNEL_IDLE_MINUTES=60
